{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"description":"Um registro de dado público extraído, com prova de origem em fonte_url.","properties":{"data":{"description":"Data em ISO 8601 (aaaa-mm-dd), como a fonte fornece.","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$","type":"string"},"fonte_url":{"format":"uri","minLength":1,"type":"string"},"nome_en":{"minLength":1,"type":"string"},"nome_local":{"minLength":1,"type":"string"},"pais":{"pattern":"^[A-Z]{2}$","type":"string"},"tipos":{"type":"string"}},"required":["data","nome_local","nome_en","pais","tipos","fonte_url"],"title":"ExtracaoDadosPublicos","type":"object"}